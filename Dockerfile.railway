# syntax=docker/dockerfile:1
# Imagen única para Railway: Nginx + PHP-FPM en un solo contenedor (supervisord).
# Railway ejecuta un servicio por contenedor y no comparte archivos entre servicios,
# por eso web y app van juntos; la base de datos es el servicio PostgreSQL de Railway.
# El frontend (Vite) se compila aquí mismo porque public/build no se versiona en git.

# ---------- 1. Frontend ----------
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

# ---------- 2. Dependencias PHP ----------
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction
COPY . .
RUN composer dump-autoload --optimize --no-dev --classmap-authoritative

# ---------- 3. Imagen final ----------
FROM php:8.3-fpm-alpine
WORKDIR /var/www/html

RUN apk add --no-cache \
        nginx \
        supervisor \
        gettext \
        postgresql-dev \
        libpng-dev \
        libjpeg-turbo-dev \
        freetype-dev \
        libwebp-dev \
        libzip-dev \
        linux-headers \
        su-exec \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install pdo_pgsql pgsql gd zip bcmath pcntl \
    && docker-php-ext-enable opcache \
    && rm -f /etc/nginx/http.d/default.conf \
    && mkdir -p /run/nginx

COPY --from=vendor --chown=www-data:www-data /app /var/www/html
COPY --from=assets --chown=www-data:www-data /app/public/build /var/www/html/public/build
COPY docker/php/php.ini /usr/local/etc/php/conf.d/zz-ecociudad.ini
COPY docker/php/www.conf /usr/local/etc/php-fpm.d/zz-ecociudad.conf
COPY docker/railway/php-fpm.conf /usr/local/etc/php-fpm.d/zz-railway.conf
COPY docker/railway/supervisord.conf /etc/supervisord.conf
COPY docker/railway/nginx.conf.template /etc/nginx/railway.conf.template
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/railway/start.sh /usr/local/bin/railway-start.sh
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/railway-start.sh \
    && mkdir -p \
        storage/app/public \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && APP_KEY=base64:dGVtcG9yYWwtYnVpbGQta2V5LXJlcGxhY2UtZW4tcnVudGltZQ== \
       php artisan package:discover --ansi \
    && chown -R www-data:www-data storage bootstrap/cache \
    && test -f public/build/manifest.json

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    RUN_MIGRATIONS=true

# Railway inyecta PORT en tiempo de ejecución; Nginx escucha en ese puerto.
EXPOSE 8080
ENTRYPOINT ["railway-start.sh"]
CMD ["supervisord", "-c", "/etc/supervisord.conf"]
