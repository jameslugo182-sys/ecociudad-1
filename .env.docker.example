APP_NAME=EcoCiudad
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://TU_DOMINIO_O_IP
APP_PORT=8080

ADMIN_NAME="Administrador EcoCiudad"
ADMIN_EMAIL=admin@ecociudad.pe
ADMIN_PASSWORD=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ecociudad
DB_USERNAME=ecociudad
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ecociudad.pe"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

RUN_MIGRATIONS=true
SEED_ADMIN=true
SEED_DEMO=false
